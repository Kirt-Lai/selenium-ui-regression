pipeline {
    environment {
        // 確保 Docker 路徑與系統 PATH
        PATH = "C:\\Windows\\System32;C:\\Program Files\\Docker\\Docker\\resources\\bin;${env.PATH}"
    }
    agent any
    parameters {
        string(name: 'sha', defaultValue: '1a2b3c4d', description: '前端傳入的版號或 SHA')
        string(name: 'site', defaultValue: 'cu', description: '測試站點參數')
    }
    stages {
        stage('Cleanup') {
            steps {
                // 刪除舊的資料夾，避免 User Data 衝突
                bat 'if exist chrome_userdata_1 rmdir /s /q chrome_userdata_1'
                bat 'if exist screenshots rmdir /s /q screenshots'
                bat 'if exist allure-results rmdir /s /q allure-results'
                bat 'if exist allure-report rmdir /s /q allure-report'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the Docker image...'
                script {
                    docker.build('pytest-project-image', '.')
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    // pytest 命令
                    def pytestCommand = "pytest -q --disable-warnings --maxfail=1 --sha=${params.sha} --site=${params.site} --alluredir=allure-results --clean-alluredir tests/"

                    // Docker run 執行測試
                    bat """
                        docker run --rm ^
                        -v "%WORKSPACE%:/app" ^
                        -w /app ^
                        pytest-project-image ^
                        cmd /c "${pytestCommand} || exit 0"
                    """
                }
            }
        }

        stage('Allure Report') {
            steps {
                script {
                    // 生成 Allure 報告，如果 allure-results 不存在也不會報錯
                    bat """
                        if exist allure-results (
                            allure generate allure-results --clean -o allure-report || exit 0
                        )
                    """
                }
            }
        }
    }

    post {
        always {
            // 封存測試結果與報告
            archiveArtifacts artifacts: 'allure-results/**, allure-report/**, report.xml', fingerprint: true

            // 確保 junit 不會因為報告不存在而 crash
            script {
                if (fileExists('report.xml')) {
                    junit 'report.xml'
                } else {
                    echo "report.xml not found, skipping junit archive"
                }
            }
        }
    }
}
